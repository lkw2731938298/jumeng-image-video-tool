{
  "name": "jumeng-media",
  "version": "0.1.2",
  "description": "DeepSeek Harness 插件：对接聚梦 AI 生图与生视频（Web UI 插件配置卡）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkw2731938298/jumeng-image-video-tool.git"
  },
  "bugs": {
    "url": "https://github.com/lkw2731938298/jumeng-image-video-tool/issues"
  },
  "homepage": "https://github.com/lkw2731938298/jumeng-image-video-tool#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "jumeng",
    "image-generation",
    "video-generation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-client.mjs",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
